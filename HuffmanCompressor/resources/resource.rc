#include <windows.h>
#include "resource.h"

// Application manifest for Common Controls v6 and Per-Monitor DPI awareness
1 24 "manifest.xml"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Huffman File Compressor & Decompressor Tool"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "HuffmanTool"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nam Luu, Huu Nguyen, Duong Hoang"
            VALUE "OriginalFilename", "HuffmanTool.exe"
            VALUE "ProductName", "Huffman File Compressor"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
